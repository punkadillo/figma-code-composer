{
  "$schema": "./config.schema.json",
  "version": "1.0",
  "project": {
    "name": "acme-web",
    "description": "Acme storefront — React 19 + Tailwind v4."
  },
  "framework": {
    "name": "react",
    "variant": "next",
    "version": "19.0.0"
  },
  "language": "ts",
  "cssSystem": {
    "name": "tailwind-v4",
    "config": {
      "prefix": "tw:",
      "configFile": "src/styles/tailwind.css",
      "extendTailwindMergePath": "src/lib/utils.ts",
      "componentDirGitignored": false
    }
  },
  "tokens": {
    "strategy": "tailwind-css-vars",
    "outputDir": "src/styles/tokens",
    "files": [
      "primitives.css",
      "semantic.css",
      "components.css"
    ],
    "namingConvention": "kebab-case",
    "prefix": "--app-",
    "fileLayout": "split"
  },
  "components": {
    "designMethodology": "atomic",
    "atomicLayout": {
      "atomsDir": "src/components/atoms",
      "moleculesDir": "src/components/molecules",
      "organismsDir": "src/components/organisms",
      "templatesDir": "src/components/templates"
    },
    "namingConvention": "PascalCase",
    "fileNaming": "match-component"
  },
  "icons": {
    "outputDir": "src/components/icons",
    "barrelFile": "index.ts",
    "fillModel": "mixed"
  },
  "stories": {
    "enabled": true,
    "framework": "storybook",
    "outputDir": "co-located",
    "titleConvention": "Components/{Layer}/{Name}",
    "testUtilsImport": "storybook/test"
  },
  "tests": {
    "unit": {
      "enabled": true,
      "framework": "vitest",
      "outputDir": "co-located",
      "testingLibrary": "react-testing-library",
      "excludeE2E": true,
      "setupFile": "vitest.setup.ts"
    },
    "e2e": {
      "enabled": true,
      "framework": "playwright",
      "outputDir": "e2e"
    }
  },
  "designSystem": {
    "name": "none"
  },
  "figma": {
    "mcpServerName": "figma",
    "defaultFileKeys": [],
    "linkConvention": "design-addon",
    "dsUrl": "https://www.figma.com/design/EXAMPLE/Design-System"
  },
  "writeScope": {
    "allowedDirs": [
      "src/components/**",
      "src/styles/tokens/**",
      "src/components/icons/**"
    ],
    "alwaysBlocked": [
      "node_modules/**",
      "dist/**",
      ".turbo/**",
      "package-lock.json",
      "yarn.lock",
      "pnpm-lock.yaml",
      ".env",
      ".env.*"
    ],
    "setupFiles": [
      "vitest.config.ts",
      "vitest.setup.ts",
      "playwright.config.ts",
      ".storybook/**",
      "src/styles/tailwind.css"
    ]
  },
  "tools": {
    "claudeCode": true,
    "cursor": true
  },
  "complexity": {
    "enabled": true,
    "thresholds": {
      "trivial": 20,
      "moderate": 50,
      "complex": 80
    }
  },
  "knowledgeGraph": {
    "enabled": true,
    "storeDir": ".figma-pipeline/kg",
    "embeddings": {
      "provider": "local",
      "model": "Xenova/all-MiniLM-L6-v2"
    },
    "retention": {
      "handoverDays": 30,
      "stagingDays": 7
    },
    "visualRegression": {
      "enabled": false,
      "thresholdPercent": 2
    }
  },
  "brevit": {
    "installed": true,
    "version": "0.0.0",
    "enabled": true,
    "mode": "flatten",
    "abbreviation": false
  },
  "setup": {
    "completedAt": "2026-06-07T00:00:00Z",
    "css": {
      "entryCss": "src/styles/tailwind.css",
      "status": "provisioned",
      "sourceDirectives": []
    },
    "unit": {
      "configPath": "vitest.config.ts",
      "setupFile": "vitest.setup.ts",
      "status": "provisioned"
    },
    "e2e": {
      "configPath": "playwright.config.ts",
      "browsersInstalled": true,
      "status": "provisioned"
    },
    "storybook": {
      "configDir": ".storybook",
      "status": "provisioned"
    },
    "depsInstalled": [
      "vitest",
      "@testing-library/react",
      "@testing-library/user-event",
      "jsdom",
      "@playwright/test",
      "storybook"
    ],
    "pending": []
  }
}
