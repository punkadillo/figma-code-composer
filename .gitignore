# Node
node_modules/
*.tgz
package-lock.json

# OS / editor
.DS_Store
.idea/
.vscode/

# Local-only
.mcp.json
.env
.env.*
!.env.example

# Runtime / scratch
/tmp/

# Knowledge graphs — this project explicitly does NOT use graphify
graphify-out/

# Generated config (created locally by /init)
.figma-pipeline/config.json

# workbench — raw trial telemetry & generated dashboards are not committed,
# but the per-trial TEXT run-config (steps, ladder, env script) IS tracked so the
# run is reproducible + visible in the repo. Heavy data (target/, ref-heroui/,
# bodies/, run dirs, node_modules) stays ignored via the broad glob below.
workbench/trials/**
!workbench/trials/
!workbench/trials/*/
!workbench/trials/*/STEPS.md
!workbench/trials/*/ladder-nodes.json
!workbench/trials/*/resume-trial.sh
workbench/reports/*/dashboard.html

# GitHub Pages build output (regenerated by .github/workflows/pages.yml)
/_site/
